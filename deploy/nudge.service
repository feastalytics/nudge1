[Unit]
Description=Nudge pilot containers
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
RequiresMountsFor=/srv/nudge

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
ExecStart=/bin/bash /opt/nudge/current/deploy/start.sh
ExecStop=/bin/bash /opt/nudge/current/deploy/stop.sh
TimeoutStartSec=300
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
